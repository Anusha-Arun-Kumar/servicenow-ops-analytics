# ServiceNow API credentials
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=your_username
SERVICENOW_PASSWORD=your_password

# Postgres warehouse connection
# Local Docker Postgres: host=postgres (inside containers) or localhost (on your Mac), sslmode=prefer
# Neon (or other cloud Postgres): host=your-neon-host, sslmode=require
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=servicenow_dw
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_password
POSTGRES_SSLMODE=prefer
